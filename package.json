{
  "name": "calorie-counter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^26.13.1"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "seed:defaults": "node scripts/seed-defaults.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "typecheck": "pnpm run typecheck:app && pnpm run typecheck:convex",
    "typecheck:app": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "typecheck:convex": "node ./node_modules/@typescript/native/bin/tsc --noEmit -p convex/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:per-file": "vitest run --config vitest.per-file.config.ts --coverage",
    "test:e2e": "playwright test",
    "test:mcp:https": "node e2e/mcp-https.ts",
    "deploy:mcp:test": "node scripts/deploy-mcp-test.ts",
    "setup:worktree": "pnpm install --frozen-lockfile",
    "dev:e2e": "vite dev --host 127.0.0.1 --port 4173 --strictPort --mode e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/localizations": "4.24.6",
    "@clerk/react": "6.18.6",
    "@convex-dev/mcp": "0.1.0-alpha.7",
    "@convex-dev/rate-limiter": "0.4.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@number-flow/react": "^0.6.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.49.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.72.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "recharts": "3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/devtools-vite": "^0.8.6",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "convex-test": "^0.0.70",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "nitro": "^3.0.261103-rc",
    "prettier": "3.10.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
